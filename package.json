  "scripts": {
    "watch": "tsc -w",
    "dev": "nodemon --watch src --ext ts --exec \"node --inspect -r ts-node/register src/server.ts\"",
    "dev:compiled": "nodemon --inspect dist/server.js",
    "jest": "jest -i",
    "jest:coverage": "jest -i --coverage",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "compile": "npx tsc",
    "tsc:init": "npx tsc --init"
  },
  "dependencies": {
